__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Datasets and checkpoints. Large and regenerable.
data/
*.pth
*.pt
*.ckpt

# Third-party papers. Downloaded under an institutional subscription and not
# redistributable; INDEX.md records what each one supplies.
references/
!references/INDEX.md

# Working copy of the simulation tree. Results are committed under results/.
python/

# Run artefacts
sim/
sim_export/
vendor/
*.jsonl
*.vcd
*.raw
*.out
*.zip

# Scratch logs at the top level. Curated ones live under results/logs/.
/logs/

# LaTeX build products
*.aux
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.log
!results/logs/*.log

# Generated CSVs and figures are ignored where they are produced, and
# committed once copied into results/ by sync_results.sh.
*.csv
paper/figures/
!results/csv/*.csv
!results/figures/*
!results/json/*

# Internal working notes: threat assessments, citation corrections, task
# lists. Kept on disk, not published.
notes/
tidy_repo.sh
